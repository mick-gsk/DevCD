{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devcd.local/schemas/devcd-continuity-packet.schema.json",
  "title": "DevCD Continuity Packet",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "context_pack",
    "surface",
    "artifacts",
    "decisions",
    "attempts",
    "blockers",
    "preferences",
    "do_not_repeat",
    "suggested_next_steps",
    "unknowns",
    "context_quality_notes",
    "withheld_context",
    "policy_decision",
    "provenance",
    "pack_metadata",
    "confidence",
    "generated_at"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "id": { "type": "string", "minLength": 1 },
    "context_pack": { "type": "string", "minLength": 1 },
    "surface": { "type": "string", "minLength": 1 },
    "intent": {
      "type": ["object", "null"],
      "required": ["summary", "status", "evidence", "updated_at", "confidence"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "status": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "object" } },
        "started_at": { "type": ["string", "null"], "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "identifier",
          "summary",
          "source",
          "relevance",
          "last_seen_at",
          "policy_reason"
        ],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "identifier": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "relevance": { "type": "number", "minimum": 0, "maximum": 1 },
          "last_seen_at": { "type": "string", "format": "date-time" },
          "policy_reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/ContinuityDecision" } },
    "attempts": { "type": "array", "items": { "$ref": "#/$defs/ContinuityAttempt" } },
    "blockers": { "type": "array", "items": { "$ref": "#/$defs/ContinuityBlocker" } },
    "preferences": { "type": "array", "items": { "$ref": "#/$defs/ContinuityPreference" } },
    "do_not_repeat": { "type": "array", "items": { "type": "string" } },
    "suggested_next_steps": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "context_quality_notes": { "type": "array", "items": { "type": "string" } },
    "withheld_context": { "type": "array", "items": { "type": "object" } },
    "policy_decision": { "type": "object" },
    "provenance": { "type": "array", "items": { "type": "string" } },
    "pack_metadata": { "type": "object" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "ContinuityAttempt": {
      "type": "object",
      "required": ["timestamp", "source", "type", "summary", "outcome", "policy_reason"],
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "source": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "enum": ["unknown", "success", "failure", "interrupted"] },
        "failure_reason": { "type": ["string", "null"] },
        "policy_reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "ContinuityBlocker": {
      "type": "object",
      "required": ["kind", "summary", "evidence", "confidence", "detected_at", "policy_reason"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "type": "object" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "detected_at": { "type": "string", "format": "date-time" },
        "reason": { "type": ["string", "null"] },
        "policy_reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "ContinuityDecision": {
      "type": "object",
      "required": ["kind", "summary", "source", "decided_at", "policy_reason"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "decided_at": { "type": "string", "format": "date-time" },
        "policy_reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "ContinuityPreference": {
      "type": "object",
      "required": ["summary", "source", "policy_reason"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "policy_reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}