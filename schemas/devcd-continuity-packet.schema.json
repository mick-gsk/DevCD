{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devcd.local/schemas/devcd-continuity-packet.schema.json",
  "title": "DevCD Continuity Packet",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "context_pack",
    "surface",
    "artifacts",
    "decisions",
    "attempts",
    "blockers",
    "preferences",
    "do_not_repeat",
    "suggested_next_steps",
    "unknowns",
    "context_quality_notes",
    "context_references",
    "context_budget",
    "session_contract",
    "withheld_context",
    "policy_decision",
    "provenance",
    "pack_metadata",
    "confidence",
    "generated_at"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "id": { "type": "string", "minLength": 1 },
    "context_pack": { "type": "string", "minLength": 1 },
    "surface": { "type": "string", "minLength": 1 },
    "intent": {
      "type": ["object", "null"],
      "required": ["summary", "status", "evidence", "updated_at", "confidence"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "status": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "object" } },
        "started_at": { "type": ["string", "null"], "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "identifier",
          "summary",
          "source",
          "relevance",
          "last_seen_at",
          "policy_reason"
        ],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "identifier": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "relevance": { "type": "number", "minimum": 0, "maximum": 1 },
          "last_seen_at": { "type": "string", "format": "date-time" },
          "policy_reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/ContinuityDecision" } },
    "attempts": { "type": "array", "items": { "$ref": "#/$defs/ContinuityAttempt" } },
    "blockers": { "type": "array", "items": { "$ref": "#/$defs/ContinuityBlocker" } },
    "preferences": { "type": "array", "items": { "$ref": "#/$defs/ContinuityPreference" } },
    "do_not_repeat": { "type": "array", "items": { "type": "string" } },
    "suggested_next_steps": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "context_quality_notes": { "type": "array", "items": { "type": "string" } },
    "context_references": { "type": "array", "items": { "$ref": "#/$defs/ContextReference" } },
    "context_budget": { "$ref": "#/$defs/ContextBudget" },
    "session_contract": { "type": ["object", "null"], "$ref": "#/$defs/SessionContract" },
    "withheld_context": { "type": "array", "items": { "type": "object" } },
    "policy_decision": { "type": "object" },
    "provenance": { "type": "array", "items": { "type": "string" } },
    "pack_metadata": { "type": "object" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "ContinuityAttempt": {
      "type": "object",
      "required": ["timestamp", "source", "type", "summary", "outcome", "policy_reason"],
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "source": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "enum": ["unknown", "success", "failure", "interrupted"] },
        "failure_reason": { "type": ["string", "null"] },
        "policy_reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "ContinuityBlocker": {
      "type": "object",
      "required": ["kind", "summary", "evidence", "confidence", "detected_at", "policy_reason"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "type": "object" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "detected_at": { "type": "string", "format": "date-time" },
        "reason": { "type": ["string", "null"] },
        "policy_reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "ContinuityDecision": {
      "type": "object",
      "required": ["kind", "summary", "source", "decided_at", "policy_reason"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "decided_at": { "type": "string", "format": "date-time" },
        "policy_reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "ContinuityPreference": {
      "type": "object",
      "required": ["summary", "source", "policy_reason"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "policy_reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "ContextReference": {
      "type": "object",
      "required": [
        "kind",
        "identifier",
        "summary",
        "source",
        "load_hint",
        "include_reason",
        "freshness",
        "confidence",
        "policy_reason",
        "discard_reason"
      ],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "identifier": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "load_hint": { "type": "string", "minLength": 1 },
        "include_reason": { "type": "string", "minLength": 1 },
        "freshness": {
          "type": "object",
          "required": ["status", "last_seen_at", "expires_at"],
          "properties": {
            "status": { "type": "string", "enum": ["current", "aging", "stale", "expired"] },
            "last_seen_at": { "type": "string", "format": "date-time" },
            "expires_at": { "type": ["string", "null"], "format": "date-time" }
          },
          "additionalProperties": false
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "policy_reason": { "type": "string", "minLength": 1 },
        "discard_reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "ContextBudget": {
      "type": "object",
      "required": [
        "estimated_tokens",
        "reference_count",
        "withheld_context_count",
        "sync_warning_ab",
        "switch_recommended_ab",
        "included_sources",
        "suggested_actions"
      ],
      "properties": {
        "estimated_tokens": { "type": "integer", "minimum": 0 },
        "reference_count": { "type": "integer", "minimum": 0 },
        "withheld_context_count": { "type": "integer", "minimum": 0 },
        "sync_warning_ab": { "type": "number", "minimum": 0, "maximum": 1 },
        "switch_recommended_ab": { "type": "number", "minimum": 0, "maximum": 1 },
        "included_sources": { "type": "array", "items": { "type": "string" } },
        "suggested_actions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "SessionContract": {
      "type": "object",
      "required": [
        "next_action",
        "definition_of_done",
        "verification_command",
        "clean_state_required",
        "sync_warning_ab",
        "switch_recommended_ab"
      ],
      "properties": {
        "next_action": { "type": "string", "minLength": 1 },
        "definition_of_done": { "type": "string", "minLength": 1 },
        "verification_command": { "type": "string", "minLength": 1 },
        "clean_state_required": { "type": "boolean" },
        "sync_warning_ab": { "type": "number", "minimum": 0, "maximum": 1 },
        "switch_recommended_ab": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}