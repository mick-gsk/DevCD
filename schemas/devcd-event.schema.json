{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devcd.local/schemas/devcd-event.schema.json",
  "title": "DevCD Event",
  "type": "object",
  "required": ["event_id", "source", "type", "timestamp", "payload"],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "enum": ["ide", "git", "task", "notes", "browser", "system"]
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    },
    "sensitivity": {
      "type": "string",
      "enum": ["normal", "sensitive"],
      "default": "normal"
    },
    "data_class": {
      "type": "string",
      "minLength": 1,
      "default": "metadata"
    }
  },
  "additionalProperties": false
}
