{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devcd.local/schemas/devcd-event.schema.json",
  "title": "DevCD Event",
  "type": "object",
  "required": ["event_id", "source", "type", "timestamp", "payload"],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "enum": ["ide", "git", "task", "notes", "browser", "system"]
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    },
    "event_class": {
      "type": ["string", "null"],
      "enum": ["dead_end", "goal.done_when", null]
    },
    "sensitivity": {
      "type": "string",
      "enum": ["normal", "sensitive"],
      "default": "normal"
    },
    "data_class": {
      "type": "string",
      "minLength": 1,
      "default": "metadata"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_class": { "const": "dead_end" }
        },
        "required": ["event_class"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["approach_summary", "reason", "related_goal"],
            "properties": {
              "approach_summary": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "related_goal": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_class": { "const": "goal.done_when" }
        },
        "required": ["event_class"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["done_when"],
            "properties": {
              "done_when": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
