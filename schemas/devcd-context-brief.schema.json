{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devcd.local/schemas/devcd-context-brief.schema.json",
  "title": "DevCD Context Brief",
  "type": "object",
  "required": [
    "surface",
    "summary",
    "relevant_artifacts",
    "open_loops",
    "recent_attempts",
    "suggested_next_steps",
    "withheld",
    "policy_decision",
    "generated_at"
  ],
  "properties": {
    "surface": { "type": "object" },
    "summary": { "type": "string" },
    "active_intent": { "type": ["object", "null"] },
    "relevant_artifacts": { "type": "array", "items": { "type": "object" } },
    "open_loops": { "type": "array", "items": { "type": "object" } },
    "recent_attempts": { "type": "array", "items": { "type": "object" } },
    "suggested_next_steps": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "#/$defs/ProactiveSuggestion" }
    },
    "withheld": { "type": "array", "items": { "type": "object" } },
    "policy_decision": { "type": "object" },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "ProactiveSuggestion": {
      "type": "object",
      "required": ["id", "summary", "rationale", "confidence", "evidence", "status", "created_at"],
      "properties": {
        "id": { "type": "string" },
        "summary": { "type": "string" },
        "rationale": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "items": { "type": "object" } },
        "status": { "type": "string", "enum": ["active", "dismissed", "expired"] },
        "created_at": { "type": "string", "format": "date-time" },
        "suppressed_until": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
