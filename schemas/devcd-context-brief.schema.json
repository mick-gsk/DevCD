{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devcd.local/schemas/devcd-context-brief.schema.json",
  "title": "DevCD Context Brief",
  "type": "object",
  "required": [
    "surface",
    "summary",
    "relevant_artifacts",
    "open_loops",
    "recent_attempts",
    "suggested_next_steps",
    "withheld",
    "policy_decision",
    "generated_at"
  ],
  "properties": {
    "surface": {
      "type": "object",
      "required": ["kind", "name", "detail_level"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "coding-agent",
            "review-agent",
            "debugging-agent",
            "subagent",
            "public-demo",
            "http",
            "cli",
            "artifact",
            "mcp",
            "vscode",
            "other"
          ]
        },
        "name": { "type": "string" },
        "detail_level": { "type": "string", "enum": ["minimal", "standard", "diagnostic"] },
        "requested_sources": { "type": "array", "items": { "type": "string" } },
        "requested_data_classes": { "type": "array", "items": { "type": "string" } },
        "allowed_state_areas": { "type": "array", "items": { "type": "string" } },
        "allowed_memory_scopes": { "type": "array", "items": { "type": "string" } },
        "withheld_fields": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "summary": { "type": "string" },
    "active_goal": { "type": ["string", "null"] },
    "active_intent": { "type": ["object", "null"] },
    "relevant_artifacts": { "type": "array", "items": { "type": "object" } },
    "git_context": { "type": "object" },
    "open_loops": { "type": "array", "items": { "type": "object" } },
    "recent_attempts": { "type": "array", "items": { "type": "object" } },
    "blockers": { "type": "array", "items": { "type": "object" } },
    "suggested_next_steps": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "#/$defs/ProactiveSuggestion" }
    },
    "resurrection": { "$ref": "#/$defs/AgentResurrectionContext" },
    "withheld_context": { "type": "array", "items": { "type": "object" } },
    "withheld": { "type": "array", "items": { "type": "object" } },
    "agent_limitations": { "type": "array", "items": { "type": "string" } },
    "context_quality_notes": { "type": "array", "items": { "type": "string" } },
    "policy_decision": { "type": "object" },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "AgentResurrectionContext": {
      "type": "object",
      "properties": {
        "current_goal": { "type": ["string", "null"] },
        "last_attempt": { "type": ["object", "null"] },
        "last_failure": { "type": ["string", "null"] },
        "last_attempted_fix": { "type": ["string", "null"] },
        "why_attempt_failed": { "type": ["string", "null"] },
        "why_it_failed": { "type": ["string", "null"] },
        "do_not_repeat": { "type": "array", "items": { "type": "string" } },
        "suggested_next_action": { "type": ["string", "null"] },
        "unknowns": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "ProactiveSuggestion": {
      "type": "object",
      "required": ["id", "summary", "rationale", "confidence", "evidence", "status", "created_at"],
      "properties": {
        "id": { "type": "string" },
        "summary": { "type": "string" },
        "rationale": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "items": { "type": "object" } },
        "status": { "type": "string", "enum": ["active", "dismissed", "expired"] },
        "created_at": { "type": "string", "format": "date-time" },
        "suppressed_until": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
